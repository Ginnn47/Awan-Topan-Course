# ==============================================================================
# Awan Topan Course - Environment Configuration Template
# Salin file ini menjadi .env dan sesuaikan nilai variabel dengan lingkungan Anda.
# JANGAN SIMPAN ATAU COMMIT CREDENTIAL ASLI KE GIT!
# ==============================================================================

# ------------------------------------------------------------------------------
# Django Core Settings
# ------------------------------------------------------------------------------
DJANGO_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
DJANGO_DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,.anymhost.com

# ------------------------------------------------------------------------------
# Production / Target Database (MySQL / MariaDB pada AnyMHost)
# ------------------------------------------------------------------------------
DB_ENGINE=mysql
MYSQL_DATABASE=nama_database_mysql
MYSQL_USER=nama_user_mysql
MYSQL_PASSWORD=rahasia_password_mysql
MYSQL_HOST=localhost
MYSQL_PORT=3306

# Alternatif nama variabel generik (didukung otomatis):
# DB_NAME=nama_database_mysql
# DB_USER=nama_user_mysql
# DB_PASSWORD=rahasia_password_mysql
# DB_HOST=localhost
# DB_PORT=3306

# ------------------------------------------------------------------------------
# Source Database (PostgreSQL) - HANYA digunakan selama proses migrasi data
# ------------------------------------------------------------------------------
SOURCE_DB_ENGINE=postgresql
SOURCE_DB_NAME=nama_database_pg_sumber
SOURCE_DB_USER=nama_user_pg
SOURCE_DB_PASSWORD=rahasia_password_pg
SOURCE_DB_HOST=localhost
SOURCE_DB_PORT=5432

# ------------------------------------------------------------------------------
# Security & Cross-Origin (CORS & CSRF)
# ------------------------------------------------------------------------------
# Masukkan domain frontend Vercel dan AnyMHost
CSRF_TRUSTED_ORIGINS=https://*.vercel.app,https://*.anymhost.com
CORS_ALLOWED_ORIGINS=https://*.vercel.app,http://localhost:5173,http://localhost:3000
CORS_ALLOW_ALL_ORIGINS=False
